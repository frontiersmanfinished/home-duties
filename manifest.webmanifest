{
  "name": "Home Duties",
  "short_name": "Home Duties",
  "description": "Shared household chore tracker",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAF7F2",
  "theme_color": "#8FB9A8",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "./?view=today", "icons": [{ "src": "icons/shortcut-today.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Add chore", "short_name": "Add chore", "url": "./?add=1", "icons": [{ "src": "icons/shortcut-add.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
